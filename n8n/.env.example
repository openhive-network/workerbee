# Copy to .env and edit. Every value has a working default.

# Host port the editor is published on.
N8N_PORT=5678

# n8n image the Hive nodes are layered onto.
N8N_VERSION=2.36.5

# Tag for the image this compose file builds.
HIVE_N8N_TAG=dev

# Timezone used by schedule nodes and shown in the editor.
TZ=UTC

# n8n log level: error, warn, info, verbose, debug.
# "debug" prints one line per node load, which is how you confirm the Hive nodes
# were picked up.
N8N_LOG_LEVEL=info

# Reaching the editor from another machine -- a LAN address, an SSH tunnel --
# means plain HTTP, and a browser will not store n8n's auth cookie over HTTP
# while it is marked Secure. The symptom is a login form that accepts your
# password and returns you to the login form. Set these three together; leave
# N8N_SECURE_COOKIE at true for anything served over TLS.
#
#   N8N_SECURE_COOKIE=false
#   N8N_HOST=192.168.1.10
#   WEBHOOK_URL=http://192.168.1.10:5678/
N8N_SECURE_COOKIE=true
N8N_HOST=localhost
N8N_PROTOCOL=http

# Postgres the example workflow writes to. Not n8n's own database -- n8n keeps
# using SQLite; this holds workflow data only.
POSTGRES_DB=hive
POSTGRES_USER=hive
POSTGRES_PASSWORD=hive
POSTGRES_PORT=5432
